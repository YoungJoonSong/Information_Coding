     "text": [
      "입력 메시지: Hello World\n",
      "SHA-256 해시값: a591a6d40bf420404a011733cfb7b190d62c65bf0bcda32b57b277d9ad9f146e\n"
     ]
    }
   ],
   "source": [
    "import hashlib\n",
    "\n",
    "# 입력 데이터\n",
    "message = \"Hello World\"\n",
    "\n",
    "# SHA-256 해시 계산\n",
    "hash_object = hashlib.sha256(message.encode())\n",
    "hash_hex = hash_object.hexdigest()\n",
    "\n",
    "print(\"입력 메시지:\", message)\n",
    "print(\"SHA-256 해시값:\", hash_hex)"
   ]
  }
 ],
